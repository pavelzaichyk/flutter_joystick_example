{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flutter-joystick-example",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./build/web",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "joystick.pavelzaichyk.com", "custom_domain": true }
  ]
}
